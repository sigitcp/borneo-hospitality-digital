---
const portfolios = [
  {
    id: 1,
    title: "Kyodai Hotel",
    result: "60K+ Views",
    url: "https://www.tiktok.com/@rheckova/photo/7641527516523531541",
  },
  {
    id: 2,
    title: "Pequena Casa Hotel",
    result: "77K+ Views",
    url: "https://www.tiktok.com/@rheckova/video/7639373394156555540",
  },
  {
    id: 3,
    title: "Dayang Resort",
    result: "67K+ Views",
    url: "https://www.tiktok.com/@rheckova/photo/7642216514774519060",
  },
  {
    id: 4,
    title: "Grand Mahkota Hotel",
    result: "72K+ Views",
    url: "https://www.tiktok.com/@renny_sari18/video/7640542827629350164",
  },
  {
    id: 5,
    title: "Prestige Villa",
    result: "138K+ Views",
    url: "https://www.tiktok.com/@renny_sari18/photo/7646307238214208788",
  },
  {
    id: 6,
    title: "Maestro Hotel",
    result: "129K+ Views",
    url: "https://www.tiktok.com/@renny_sari18/video/7646701567365778709",
  },
];

async function getTikTokThumbnail(url: string) {
  try {
    const res = await fetch(
      `https://www.tiktok.com/oembed?url=${encodeURIComponent(url)}`
    );

    if (!res.ok) return null;

    const data = await res.json();
    return data.thumbnail_url || null;
  } catch {
    return null;
  }
}

const portfoliosWithThumbnail = await Promise.all(
  portfolios.map(async (item) => ({
    ...item,
    thumbnail: await getTikTokThumbnail(item.url),
  }))
);
---

<section id="portfolio" class="featured-projects py-5 py-lg-11 py-xl-12 bg-light-gray">
  <div class="d-flex flex-column gap-5 gap-xl-11">

    <div class="container">
      <div class="row gap-7 gap-xl-0">

        <div class="col-xl-4 col-xxl-4">
          <div
            class="d-flex align-items-center gap-7 py-2"
            data-aos="fade-right"
            data-aos-delay="100"
            data-aos-duration="1000"
          >
            <span class="round-36 flex-shrink-0 text-dark rounded-circle bg-primary hstack justify-content-center fw-medium">
              02
            </span>
            <hr class="border-line" />
            <span class="badge text-bg-dark">Portfolio</span>
          </div>
        </div>

        <div class="col-xl-8 col-xxl-7">
          <div class="row">
            <div class="col-xxl-8">
              <div
                class="d-flex flex-column gap-6"
                data-aos="fade-up"
                data-aos-delay="100"
                data-aos-duration="1000"
              >
                <h2 class="mb-0">Video Hospitality yang Pernah Dikerjakan</h2>
                <p class="fs-5 mb-0">
                  Beberapa konten video untuk hotel, villa, guest house, dan resort
                  yang dibuat untuk membantu properti tampil lebih menarik di platform digital.
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="featured-projects-slider px-3">
      <div class="owl-carousel owl-theme portfolio-carousel">

        {portfoliosWithThumbnail.map((item) => (
          <div class="item" data-portfolio-id={item.id}>
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-decoration-none text-dark"
            >
              <div class="portfolio d-flex flex-column gap-6">

                <div class="portfolio-img portfolio-thumb position-relative overflow-hidden">
                  {item.thumbnail ? (
  <img
    src={item.thumbnail}
    alt={item.title}
    loading="lazy"
  />
) : (
  <div class="portfolio-thumb-fallback">
    <div class="fallback-content">
      <iconify-icon icon="logos:tiktok-icon"></iconify-icon>

      <span class="fallback-label">
        Preview Tidak Tersedia
      </span>

      <h4 class="fallback-title">
        {item.title}
      </h4>

      <p class="fallback-description">
        Klik untuk melihat video lengkap di TikTok.
      </p>
    </div>
  </div>
)}

                  <div class="portfolio-play">
                    <iconify-icon icon="solar:play-bold"></iconify-icon>
                  </div>
                </div>

                <div class="portfolio-details d-flex flex-column gap-3">
                  <h3 class="mb-0">{item.title}</h3>

                  <div class="hstack gap-2 flex-wrap">
                    <span class="badge text-dark border">{item.result}</span>
                  </div>
                </div>

              </div>
            </a>
          </div>
        ))}

      </div>
    </div>

  </div>
</section>
