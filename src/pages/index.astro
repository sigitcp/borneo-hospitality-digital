---
import BaseLayout from '../layouts/BaseLayout.astro';

import BannerSection from '../components/home/BannerSection.astro';
import StatsFactsSection from '../components/home/StatsFactsSection.astro';
import FeaturedProjectsSection from '../components/home/FeaturedProjectsSection.astro';
import ServicesSection from '../components/home/ServicesSection.astro';
import WhyChooseUsSection from '../components/home/WhyChooseUsSection.astro';
import TestimonialSection from '../components/home/TestimonialSection.astro';
import TeamSection from '../components/home/TeamSection.astro';
import PricingSection from '../components/home/PricingSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
// import RecentNewsSection from '../components/home/RecentNewsSection.astro';
import GetInTouchSection from '../components/home/GetInTouchSection.astro';
---

<BaseLayout
  title="Jasa Digital Marketing Hotel | Hotel Marketing Agency"
  description="Agency digital marketing hotel untuk membantu meningkatkan direct booking, traffic website, dan lead reservasi melalui SEO, website, dan iklan digital."
>
  <div class="page-wrapper overflow-hidden">
    <BannerSection />
    <StatsFactsSection />
    <FeaturedProjectsSection />
    <ServicesSection />
    <WhyChooseUsSection />
    <TestimonialSection />
    <TeamSection />
    <PricingSection />
    <FaqSection />
    <!-- <RecentNewsSection /> -->
    <GetInTouchSection />
  </div>
</BaseLayout>
